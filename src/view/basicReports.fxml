<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="controller.BasicReportsController" style="-fx-padding: 20;">
    
    <Label text="Restaurant Performance Report" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <TableView fx:id="reportTable" prefHeight="300" prefWidth="400">
        <columns>
            <TableColumn fx:id="nameColumn" text="Restaurant" prefWidth="150"/>
            <TableColumn fx:id="ordersColumn" text="Orders" prefWidth="100"/>
            <TableColumn fx:id="revenueColumn" text="Revenue" prefWidth="150"/>
        </columns>
    </TableView>
    
    <Button text="Close" onAction="#handleClose"/>
</VBox>