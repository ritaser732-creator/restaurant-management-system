<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" prefHeight="250.0" prefWidth="350.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AssignRestaurantController">
    <children>
        <Label text="Assign to Restaurant" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="lblAdminName" text="Admin: " />
        
        <TextField fx:id="fldRestaurantCode" maxWidth="200.0" promptText="Enter Restaurant Code (e.g. Re0001)" />
        
        <Label fx:id="lblError" textFill="RED" />
        
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAssign" text="Assign" />
                <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
            </children>
        </HBox>
    </children>
</VBox>