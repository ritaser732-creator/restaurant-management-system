<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" 
      prefHeight="400.0" 
      prefWidth="400.0" 
      spacing="15.0" 
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RiderLoginController">
<children>
<Label text="Rider Login">
<font>
<Font name="System Bold" size="20.0" />
</font>
<VBox.margin>
<Insets bottom="10.0" />
</VBox.margin>
</Label>
<TextField fx:id="fldRiderId" maxWidth="200.0" promptText="Enter Rider ID (e.g. Ri0001)" />
<Label fx:id="lblError" textFill="RED" />
<Button fx:id="btnLogin" mnemonicParsing="false" onAction="#handleLogin" prefWidth="100.0" text="Login"/>
<Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBack" prefWidth="100.0" text="Back" />
</children>
</VBox>