<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="15.0" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.AddRestAdminController">
    <children>
        <Label text="Add New Restaurant Admin" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <TextField fx:id="fldFirstName" maxWidth="200.0" promptText="First Name" />
        <TextField fx:id="fldUsername" maxWidth="200.0" promptText="Username" />
        <PasswordField fx:id="fldPassword" maxWidth="200.0" promptText="Password" />
        
        <Label fx:id="lblError" textFill="RED" />
        
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleSave" text="Save" />
                <Button mnemonicParsing="false" onAction="#handleCancel" text="Cancel" />
            </children>
        </HBox>
    </children>
</VBox>