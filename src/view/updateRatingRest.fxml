<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="controller.UpdateRatingRestController" style="-fx-padding: 20;">
    
    <Label text="Update Restaurant Rating" style="-fx-font-size: 16px;"/>
    
    <ComboBox fx:id="restaurantComboBox" promptText="Select Restaurant" prefWidth="250"/>
    
    <TextField fx:id="ratingField" promptText="Enter New Rating (1-5)"/>
    
    <Button text="Update Rating" onAction="#handleUpdate" style="-fx-background-color: blue; -fx-text-fill: white;"/>
    
    <Label fx:id="statusLabel"/>
</VBox>