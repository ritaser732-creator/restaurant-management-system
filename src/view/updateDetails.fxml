<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.UpdateDetailsController">
    <TextField fx:id="firstNameField" promptText="First Name"/>
    <TextField fx:id="lastNameField" promptText="Last Name"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <TextField fx:id="phoneField" promptText="Number Phone"/>
    <TextField fx:id="streetField" promptText="Street"/>
    <TextField fx:id="cityField" promptText="City"/>
    <TextField fx:id="zipCodeField" promptText="ZipCode"/>
    
    <Button text="Сохранить изменения" onAction="#handleSave"/>
    <Label fx:id="messageLabel"/>
</VBox>